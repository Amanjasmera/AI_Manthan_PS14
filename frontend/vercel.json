{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-manthan-ps14.onrender.com/api/:path*"
    },
    {
      "source": "/prototype.html",
      "destination": "/prototype.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
